{
  "name": "@pq/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST API for Polyglot Quiz",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "content:report": "tsx src/content/report-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@pq/shared": "*",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.2"
  }
}
