# API
PORT=3000
HOST=127.0.0.1
# Path to the SQLite file. Use :memory: for a throwaway database (tests).
DB_PATH=./data/quiz.db
# Postgres for leaderboard entries (production, e.g. Neon). Leave empty to keep them in SQLite.
DATABASE_URL=
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Web (build time)
# The API's origin when it runs on another host (production). Empty = same origin via /api proxy.
VITE_API_URL=

# Vitest
# A throwaway Postgres database for the Postgres leaderboard-store tests (CI sets it).
TEST_DATABASE_URL=

# Playwright
# Base URL of the web app under test.
BASE_URL=http://localhost:4173
# Base URL of the API under test.
API_URL=http://127.0.0.1:3000
# Use an installed browser instead of Playwright's bundled Chromium (e.g. chrome).
PW_CHANNEL=
